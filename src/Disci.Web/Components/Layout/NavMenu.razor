@implements IDisposable

@inject NavigationManager NavigationManager

<a class="side-brand" href="">
    <span class="logo"><Icon Name="tooth" /></span>
    <span>Disci<small>Diş kliniği yönetimi</small></span>
</a>

<nav class="side-nav">
    <AuthorizeView>
        <Authorized>
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="home" /> Bugün</NavLink>
            <NavLink class="nav-link" href="randevular"><Icon Name="calendar" /> Randevular</NavLink>
            <NavLink class="nav-link" href="hastalar"><Icon Name="users" /> Hastalar</NavLink>
            <NavLink class="nav-link" href="receteler"><Icon Name="pill" /> Reçeteler</NavLink>
            <NavLink class="nav-link" href="bildirimler"><Icon Name="bell" /> Bildirimler ve görevler</NavLink>

            <AuthorizeView Roles="@($"{Roles.Admin},{Roles.Dentist}")" Context="finance">
                <div class="side-label">Finans</div>
                <NavLink class="nav-link" href="kasa"><Icon Name="wallet" /> Kasa ve tahsilat</NavLink>
                <NavLink class="nav-link" href="fiyatlar"><Icon Name="tag" /> Fiyat listeleri</NavLink>
            </AuthorizeView>

            <AuthorizeView Roles="@Roles.Admin" Context="admin">
                <div class="side-label">Yönetim</div>
                <NavLink class="nav-link" href="ayarlar"><Icon Name="settings" /> Klinik ayarları</NavLink>
                <NavLink class="nav-link" href="yonetim/kullanicilar"><Icon Name="shield" /> Kullanıcılar</NavLink>
            </AuthorizeView>
        </Authorized>
        <NotAuthorized>
            <NavLink class="nav-link" href="Account/Login"><Icon Name="user" /> Giriş</NavLink>
            <NavLink class="nav-link" href="kilavuz"><Icon Name="book" /> Kullanım kılavuzu</NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

<AuthorizeView>
    <div class="side-foot">
        <NavLink class="nav-link d-flex align-items-center gap-2 px-2 py-2 text-body" href="kilavuz"><Icon Name="book" /> Kullanım kılavuzu</NavLink>
        <NavLink class="nav-link d-flex align-items-center gap-2 px-2 py-2 text-body" href="Account/Manage"><Icon Name="user" /> Hesabım</NavLink>
        <form action="Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
            <button type="submit" class="btn btn-link text-secondary d-flex align-items-center gap-2 px-2 text-decoration-none">
                <Icon Name="logout" /> Çıkış
            </button>
        </form>
    </div>
</AuthorizeView>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
