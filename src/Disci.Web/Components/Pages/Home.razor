@page "/"
@inject IDbContextFactory<DisciDbContext> DbFactory

<PageTitle>Ana sayfa - Disci</PageTitle>

<h1 class="h3 mb-3">Ana sayfa</h1>

<form action="hastalar" method="get" class="mb-4" role="search">
    <div class="input-group input-group-lg">
        <input name="ara" class="form-control" placeholder="Hasta ara: ad, soyad, telefon veya protokol no" aria-label="Hasta ara" />
        <button class="btn btn-primary" type="submit">Ara</button>
    </div>
</form>

@if (stats is null)
{
    <p class="text-secondary">Yükleniyor...</p>
}
else
{
    <div class="row g-3 mb-4">
        <StatCard Title="Kayıtlı hasta" Value="@stats.Patients.ToString("N0")" />
        <StatCard Title="Bu ay yeni hasta" Value="@stats.NewPatientsThisMonth.ToString("N0")" />
        <StatCard Title="Bu ay tedavi" Value="@Display.Money(stats.TreatmentsThisMonth)" />
        <StatCard Title="Bu ay tahsilat" Value="@Display.Money(stats.PaymentsThisMonth)" />
    </div>

    <h2 class="h5">Son işlem yapılan hastalar</h2>
    <div class="list-group">
        @foreach (var v in stats.RecentVisits)
        {
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="hastalar/@v.PatientId">
                <span>@v.Name</span>
                <span class="text-secondary small">@Display.Date(v.Date)</span>
            </a>
        }
    </div>
}

@code {
    private Stats? stats;

    private sealed record Visit(int PatientId, string Name, DateOnly Date);

    private sealed record Stats(int Patients, int NewPatientsThisMonth, decimal TreatmentsThisMonth, decimal PaymentsThisMonth, List<Visit> RecentVisits);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var today = DateOnly.FromDateTime(DateTime.Today);
        var monthStart = new DateOnly(today.Year, today.Month, 1);

        var recent = await db.TreatmentSessions
            .Where(s => s.Kind == TreatmentKind.Completed && s.Date <= today)
            .GroupBy(s => s.PatientId)
            .Select(g => new { PatientId = g.Key, Date = g.Max(s => s.Date) })
            .OrderByDescending(x => x.Date).Take(10)
            .Join(db.Patients, x => x.PatientId, p => p.Id, (x, p) => new { x.PatientId, p.FirstName, p.LastName, x.Date })
            .ToListAsync();

        stats = new Stats(
            await db.Patients.CountAsync(p => !p.IsArchived),
            await db.Patients.CountAsync(p => p.RegisteredOn >= monthStart),
            await db.TreatmentItems
                .Where(i => i.TreatmentSession.Kind == TreatmentKind.Completed && i.TreatmentSession.Date >= monthStart && i.Currency == Currencies.Try)
                .SumAsync(i => (decimal?)i.Price) ?? 0,
            await db.Payments
                .Where(p => p.Date >= monthStart && !p.IsCancelled && p.Currency == Currencies.Try)
                .SumAsync(p => (decimal?)p.Amount) ?? 0,
            recent.Select(r => new Visit(r.PatientId, $"{r.FirstName} {r.LastName}", r.Date)).ToList());
    }
}
