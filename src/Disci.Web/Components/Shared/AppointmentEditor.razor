@inject IDbContextFactory<DisciDbContext> DbFactory
@inject ClinicEvents Events
@inject CurrentUser Me

<Modal Title="@(AppointmentId is null ? "Yeni randevu" : "Randevu")" OnClose="OnClose">
    <ChildContent>
        @if (loading)
        {
            <p class="text-secondary">Yükleniyor...</p>
        }
        else if (dentists.Count == 0)
        {
            <div class="callout callout-warning"><Icon Name="alert" /> Önce Klinik ayarları sayfasından en az bir hekim ekleyin.</div>
        }
        else
        {
            @if (readOnly)
            {
                <div class="callout callout-info mb-3"><Icon Name="alert" /> Bu randevu başka bir hekime ait; yalnızca görüntüleyebilirsiniz.</div>
            }
            <div class="row g-3">
                <div class="col-12">
                    <div class="d-flex align-items-center mb-1">
                        <label class="form-label m-0">Hasta</label>
                        <div class="form-check form-switch ms-auto small">
                            <input class="form-check-input" type="checkbox" id="guest" @bind="guest" />
                            <label class="form-check-label" for="guest">Kayıtsız hasta</label>
                        </div>
                    </div>
                    @if (guest)
                    {
                        <div class="row g-2">
                            <div class="col-sm-7"><input class="form-control" placeholder="Ad soyad" @bind="guestName" /></div>
                            <div class="col-sm-5"><input class="form-control" placeholder="Telefon" @bind="guestPhone" /></div>
                        </div>
                    }
                    else
                    {
                        <PatientPicker @bind-Selected="patient" />
                    }
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="ap-dentist">Hekim</label>
                    <select id="ap-dentist" class="form-select" @bind="dentistId">
                        @foreach (var d in dentists)
                        {
                            <option value="@d.Id">@d.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6">
                    <label class="form-label" for="ap-type">İşlem türü</label>
                    <select id="ap-type" class="form-select" @bind="typeId" @bind:after="TypeChanged">
                        <option value="0">Genel muayene / diğer</option>
                        @foreach (var t in types)
                        {
                            <option value="@t.Id">@t.Name (@t.DurationMinutes dk)</option>
                        }
                    </select>
                </div>
                <div class="col-sm-5">
                    <label class="form-label" for="ap-date">Tarih</label>
                    <input id="ap-date" type="date" class="form-control" @bind="date" />
                </div>
                <div class="col-6 col-sm-3">
                    <label class="form-label" for="ap-time">Saat</label>
                    <input id="ap-time" type="time" step="300" class="form-control" @bind="time" />
                </div>
                <div class="col-6 col-sm-4">
                    <label class="form-label" for="ap-dur">Süre</label>
                    <select id="ap-dur" class="form-select" @bind="duration">
                        @foreach (var m in Durations)
                        {
                            <option value="@m">@(m < 60 ? $"{m} dk" : m % 60 == 0 ? $"{m / 60} saat" : $"{m / 60} sa {m % 60} dk")</option>
                        }
                    </select>
                </div>
                @if (AppointmentId is not null)
                {
                    <div class="col-12">
                        <label class="form-label">Durum</label>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var s in Display.StatusFlow)
                            {
                                <button type="button" class="chip @(status == s ? "active" : "")" @onclick="() => status = s">@Display.Name(s)</button>
                            }
                        </div>
                    </div>
                }
                <div class="col-12">
                    <label class="form-label" for="ap-notes">Not</label>
                    <textarea id="ap-notes" class="form-control" rows="2" @bind="notes" placeholder="Şikâyet, yapılacak işlem..."></textarea>
                </div>
            </div>

            @if (conflicts.Count > 0)
            {
                <div class="callout callout-danger mt-3">
                    <Icon Name="alert" />
                    <div>
                        <div class="fw-650">Bu saat dolu</div>
                        @foreach (var c in conflicts)
                        {
                            @if (access.CanSee(c.DentistId))
                            {
                                <div>@Display.Time(c.Start)–@Display.Time(c.End) · @(c.Patient?.FullName ?? c.GuestName) · @c.Dentist.FullName</div>
                            }
                            else
                            {
                                <div>@Display.Time(c.Start)–@Display.Time(c.End) · hastanın başka bir hekimde randevusu var</div>
                            }
                        }
                    </div>
                </div>
            }
            @if (error is not null)
            {
                <div class="callout callout-warning mt-3"><Icon Name="alert" /> @error</div>
            }
        }
    </ChildContent>
    <Footer>
        @if (AppointmentId is not null && reminderLink is not null)
        {
            <a class="btn btn-light me-auto" href="@reminderLink" target="_blank" rel="noopener" title="WhatsApp ile hatırlatma mesajı hazırla">
                <Icon Name="message" /> Hatırlat
            </a>
        }
        @if (patient is not null && AppointmentId is not null)
        {
            <a class="btn btn-light" href="hastalar/@patient.Id">Hasta kartı</a>
        }
        <button type="button" class="btn btn-light" @onclick="OnClose">Vazgeç</button>
        <button type="button" class="btn btn-primary" disabled="@(saving || readOnly || dentists.Count == 0)" @onclick="Save"><Icon Name="check" /> Kaydet</button>
    </Footer>
</Modal>

@code {
    [Parameter] public int? AppointmentId { get; set; }
    [Parameter] public DateTime? DefaultStart { get; set; }
    [Parameter] public int? DefaultDentistId { get; set; }
    [Parameter] public PatientPicker.PatientOption? DefaultPatient { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly int[] Durations = [10, 15, 20, 30, 45, 60, 75, 90, 120, 150, 180];

    private bool loading = true, saving, guest, readOnly;
    private AccessScope access = AccessScope.Everything;
    private List<Dentist> dentists = [];
    private List<AppointmentType> types = [];
    private PatientPicker.PatientOption? patient;
    private string? guestName, guestPhone, notes, error, reminderLink;
    private int dentistId, typeId, duration = 30;
    private DateOnly date;
    private TimeOnly time;
    private AppointmentStatus status = AppointmentStatus.Scheduled;
    private List<Appointment> conflicts = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        access = await Me.AccessAsync();
        dentists = await db.Dentists.AsNoTracking().Editable(access).Where(d => d.IsActive).OrderBy(d => d.FullName).ToListAsync();
        types = await db.AppointmentTypes.AsNoTracking().Where(t => t.IsActive).OrderBy(t => t.Name).ToListAsync();

        if (AppointmentId is { } id && await db.Appointments.AsNoTracking().Include(a => a.Patient).Include(a => a.Dentist).FirstOrDefaultAsync(a => a.Id == id) is { } a)
        {
            patient = a.Patient is null ? null : new(a.Patient.Id, a.Patient.FullName, a.Patient.MobilePhone, a.Patient.LegacyId, a.Patient.SecondProtocol);
            guest = a.PatientId is null;
            guestName = a.GuestName;
            guestPhone = a.GuestPhone;
            dentistId = a.DentistId;
            readOnly = !access.CanEdit(a.DentistId);
            if (!dentists.Any(d => d.Id == a.DentistId)) dentists.Insert(0, a.Dentist);
            typeId = a.AppointmentTypeId ?? 0;
            date = DateOnly.FromDateTime(a.Start);
            time = TimeOnly.FromDateTime(a.Start);
            duration = Math.Max(5, (int)(a.End - a.Start).TotalMinutes);
            status = a.Status;
            notes = a.Notes;
            reminderLink = Display.WhatsApp(a.Patient?.MobilePhone ?? a.GuestPhone,
                Display.ReminderText(a.Patient?.FullName ?? a.GuestName ?? "", a.Start, a.Dentist.FullName));
            if (!Durations.Contains(duration)) duration = Durations.MinBy(d => Math.Abs(d - duration));
        }
        else
        {
            var start = DefaultStart ?? NextSlot(DateTime.Now);
            date = DateOnly.FromDateTime(start);
            time = TimeOnly.FromDateTime(start);
            patient = DefaultPatient;
            var mine = await Me.DentistIdAsync();
            dentistId = DefaultDentistId is { } dd && dentists.Any(d => d.Id == dd) ? dd : (mine is { } m && dentists.Any(d => d.Id == m) ? m : dentists.FirstOrDefault()?.Id ?? 0);
        }
        loading = false;
    }

    private static DateTime NextSlot(DateTime now)
    {
        var t = now.AddMinutes(15 - now.Minute % 15);
        return new DateTime(t.Year, t.Month, t.Day, t.Hour, t.Minute, 0);
    }

    private void TypeChanged()
    {
        if (types.FirstOrDefault(t => t.Id == typeId) is { DurationMinutes: > 0 } t)
            duration = Durations.MinBy(d => Math.Abs(d - t.DurationMinutes));
    }

    private async Task Save()
    {
        error = null;
        conflicts = [];
        if (readOnly || !access.CanEdit(dentistId))
        {
            error = "Bu hekimin randevularında işlem yetkiniz yok.";
            return;
        }
        if (guest ? string.IsNullOrWhiteSpace(guestName) : patient is null)
        {
            error = guest ? "Kayıtsız hasta için ad soyad yazın." : "Bir hasta seçin.";
            return;
        }

        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var a = AppointmentId is { } id ? await db.Appointments.FirstAsync(x => x.Id == id) : new Appointment();
            a.PatientId = guest ? null : patient!.Id;
            a.GuestName = guest ? guestName!.Trim() : null;
            a.GuestPhone = guest ? guestPhone?.Trim() : null;
            a.DentistId = dentistId;
            a.AppointmentTypeId = typeId == 0 ? null : typeId;
            a.Start = date.ToDateTime(time);
            a.End = a.Start.AddMinutes(duration);
            a.Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim();
            if (a.Status != status)
                Scheduling.SetStatus(a, status, DateTime.Now);

            // Cancelled or missed appointments free their slot; only live bookings are checked.
            if (!Scheduling.Inactive.Contains(a.Status))
            {
                conflicts = await Scheduling.ConflictsAsync(db, a);
                if (conflicts.Count > 0) return;
            }

            if (a.Id == 0)
            {
                a.CreatedByUserId = await Me.IdAsync();
                db.Appointments.Add(a);
            }
            await db.SaveChangesAsync();
            await Events.NotifyAsync();
            await OnSaved.InvokeAsync();
        }
        finally
        {
            saving = false;
        }
    }
}
